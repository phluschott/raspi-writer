{
  "compilerOptions": {
    "baseUrl": ".",
    "inlineSourceMap": true,
    "inlineSources": true,
    "module": "ESNext",
    "target": "ES2018",
    "allowSyntheticDefaultImports": true,
    "moduleResolution": "node",
    "strictNullChecks": true,
    "lib": ["DOM", "ES6", "ES2017", "ES2018"],
    "outDir": "."
  },
  "include": ["src/**/*.ts"]
}
